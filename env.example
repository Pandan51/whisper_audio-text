# --- Model ---
# Hugging Face name or local path to a CTranslate2-converted model
WHISPER_MODEL=czechspeech-ct2
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Performance ---
# Threads per worker. Start with physical cores (or the container CPU limit).
WHISPER_CPU_THREADS=8

# Keep at 1 when the message queue handles concurrency
WHISPER_NUM_WORKERS=1

# --- Decoding ---
WHISPER_BEAM_SIZE=1

WHISPER_VAD_FILTER=true
# Empty = auto-detect, otherwise e.g. cs / en
WHISPER_LANGUAGE=cs

# --- Benchmark only ---
# Comma-separated values to try; each combination is measured
BENCH_THREADS=4,6,8
BENCH_BEAM_SIZES=1,5
BENCH_RUNS=2
